{
  "name": "mcp-sap-adt-local",
  "version": "0.1.0",
  "description": "Local multi-system SAP ADT and allowlisted OData MCP server",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.1"
  },
  "bin": {
    "mcp-sap-adt-local": "dist/cli/index.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "skills",
    "config",
    "docs",
    "scripts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:mcp": "vitest run tests/mcp",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint src tests",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@mcp-abap-adt/adt-clients": "10.1.0",
    "@mcp-abap-adt/interfaces": "13.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "14.0.3",
    "fast-xml-parser": "5.10.1",
    "undici": "7.29.0",
    "yaml": "2.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@types/node": "22.18.0",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
